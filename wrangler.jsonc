// Cloudflare deploy config: serves the static Astro build from dist/.
{
  "name": "aman-babycare-website",
  "compatibility_date": "2026-10-01",
  // Served only on amancareservices.com (custom domain, set in the Cloudflare dashboard). The *.workers.dev
  // address and per-version preview URLs stay off, so search engines never index a second copy of the site.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
