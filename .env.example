# Copy to .env and fill in. All values are public (exposed to the browser).

# Production URL, e.g. https://amanbabycare.sa (used for canonical, hreflang, sitemap).
PUBLIC_SITE_URL=

# Analytics: scripts load only after cookie consent and only when an ID is set.
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_SNAP_PIXEL_ID=

# Admin panel (separate project): booking requests are saved at <PUBLIC_ADMIN_API_URL>/api/bookings.
# Empty = nothing saved, WhatsApp only. Local admin dev server: http://localhost:4330
PUBLIC_ADMIN_API_URL=
# Cloudflare Turnstile site key for the booking form (the admin holds the secret). Empty = no bot check.
PUBLIC_TURNSTILE_SITE_KEY=

# Search indexing. "true" on the production build only; anything else = noindex + robots.txt Disallow.
PUBLIC_INDEXING=false
