---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeartLine from '../components/HeartLine.astro';
---

<BaseLayout
  lang="en"
  title="Page not found | Aman"
  description="The page you are looking for does not exist. Go back to the Aman home page."
  path="404"
  alternates={false}
  notFound
>
  <section class="container-x py-24 pb-40 text-center">
    <HeartLine class="mx-auto w-40 text-gold-500" />
    <h1 class="mt-6 text-4xl text-green-800">Page not found</h1>
    <p class="mt-4 text-ink-600">The link may have changed. Here are the main pages:</p>
    <p class="mt-1 text-ink-500" lang="ar" dir="rtl">الصفحة غير موجودة. هذه أهم الصفحات:</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-ghost" href="/services/">Services</a>
      <a class="btn btn-ghost" href="/ar/" lang="ar">الصفحة الرئيسية (العربية)</a>
    </div>
  </section>
</BaseLayout>
