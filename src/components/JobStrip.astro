---
// Careers strip: one quiet line at the very top of every page while at least one role is open (src/data/jobs.ts),
// so caregivers looking for work find the Careers page without parents being interrupted. Never a popup.
// Closing it hides it on that device: BaseLayout's <head> adds `hide-job-strip` to <html> before the first paint
// when the choice is stored, so it never flashes. Not shown on the Careers page itself.
import Icon from './Icon.astro';
import type { Locale } from '../config/site';
import { hiring } from '../data/jobs';
import { href, ui } from '../i18n/ui';

interface Props {
  lang: Locale;
  path: string;
}
const { lang, path } = Astro.props;
const show = hiring && path !== 'careers';
---

{
  show && (
    <div class="border-b border-green-700/10 bg-cream-50 text-sm text-green-800 in-[.hide-job-strip]:hidden" data-job-strip>
      <div class="container-x flex items-center gap-2">
        <a href={href(lang, 'careers')} class="flex min-h-11 flex-1 items-center justify-center gap-2 py-1.5 text-center hover:text-green-900">
          <Icon name="hands" class="size-4 shrink-0 text-gold-600" />
          <span>
            <span class="hidden sm:inline">{ui.jobStrip[lang]} </span>
            <span class="font-semibold underline decoration-gold-500/60 underline-offset-4">{ui.nav.careers[lang]}: {ui.jobStripCta[lang]}</span>
          </span>
          <Icon name="chevron" class="size-4 shrink-0 text-gold-600" flip />
        </a>
        <button
          type="button"
          class="-me-3 flex size-11 shrink-0 items-center justify-center rounded-full text-ink-500 hover:bg-cream-200 hover:text-green-800 active:scale-95"
          aria-label={ui.jobStripClose[lang]}
          data-job-strip-close
        >
          <Icon name="close" class="size-4" />
        </button>
      </div>
    </div>
  )
}

<script>
  // Key matches the check in BaseLayout's <head>.
  document.querySelector('[data-job-strip-close]')?.addEventListener('click', () => {
    document.documentElement.classList.add('hide-job-strip');
    try {
      localStorage.setItem('aman-job-strip', 'hidden');
    } catch {
      // Private mode: hidden for this page view only.
    }
  });
</script>
