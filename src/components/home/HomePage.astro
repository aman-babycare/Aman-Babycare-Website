    ],
    trustTitle: 'Peace of mind before we arrive',
    trustText: 'Everyone on our team is background-checked before they enter any home. We ask about your house rules before the first visit, and we keep them.',
    trustAlt: 'A caregiver in a Saudi family home',
    trustPoints: ['Background checks for every team member', `Caregivers speak ${business.languages.en}`, 'Your house rules and privacy, respected', 'WhatsApp updates during the visit'],
    firstTitle: 'Be among our first families',
    firstText: "Aman is just beginning. We won't show reviews we haven't earned yet; we'd rather earn your trust one visit at a time.",
    firstCta: 'Book your first visit',
    faqTitle: 'Common questions',
    closeTitle: 'Your comfort, our priority',
    closeText: 'One WhatsApp message, and we take it from there.',
    aboutTitle: 'About Aman in Riyadh',
    aboutText: `Aman Babycare & Home Services helps families all over Riyadh, with newborn and mother care, babysitters and nannies, elderly companionship, an hourly maid for home cleaning, errands, school pick-ups, and cat and dog sitting. We work a day shift (${business.shifts.day.time.en}) and a night shift (${business.shifts.night.time.en}), by the hour or by the month, live-in or live-out. Everyone on our team is background-checked and speaks ${business.languages.en}, and you choose a male or female caregiver. One caregiver can combine several services in a single visit. On this site you will find a page for every service, clear hourly, weekly and monthly packages, and offers for Ramadan, Eid and national occasions. You book directly on WhatsApp; we reply ${business.hours.time.en} and confirm the price and every detail before you commit.`,
    aboutLink: 'Get to know Aman',
  },
}[lang];

const offerMessage = (event: string) =>
  lang === 'ar' ? `السلام عليكم، أرغب بالاستفادة من عرض ${event}.` : `Hello, I'd like to book the ${event} offer.`;
const welcomeMsg = lang === 'ar' ? `السلام عليكم، أرغب بـ${welcomeOffer.name.ar}.` : `Hello, I'd like the ${welcomeOffer.name.en}.`;
// Three signature packages; if a service switched off in the admin took one away, show the first three that remain.
const signature = ['hourly-babysitting', 'monthly-6', 'stay-in'].flatMap((id) => packages.find((p) => p.id === id) ?? []);
const teaser = signature.length === 3 ? signature : packages.slice(0, 3);
---

<!-- Hero. Phones: headline, trust points, buttons, then the photo. Desktop: text and buttons beside the
     photo, with the trust points as a strip underneath. -->
<section class="relative isolate overflow-hidden">
  <HeroBackdrop />
  <div class="container-x grid gap-8 pb-16 pt-10 md:pt-16 lg:grid-cols-[1.1fr_1fr] lg:gap-x-16 lg:gap-y-8 lg:pb-20">
    <div class="rise lg:col-start-1 lg:row-start-1 lg:self-end">
      <h1 class="max-w-[16ch] text-4xl text-green-800 sm:text-5xl lg:text-6xl">{tr(seo.home.h1, lang)}</h1>
      <p class="mt-4 max-w-xl text-xl font-medium text-green-700">{tr(homeKeywordLine, lang)}</p>
      <p class="mt-4 max-w-xl text-lg text-ink-600">{c.lead}</p>
    </div>

    <ul class="rise grid gap-3 sm:grid-cols-3 lg:col-span-2 lg:row-start-3 lg:gap-6 lg:border-t lg:border-gold-500/25 lg:pt-8" aria-label={c.trustLabel}>
      {
        c.trust.map((t, i) => (
          <li class="flex items-center gap-3 text-sm font-medium text-ink-700">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-cream-50 text-green-700 shadow-soft">
              <Icon name={(['shield', 'hands', 'whatsapp'] as const)[i]} class="size-5" />
            </span>
            {t}
          </li>
        ))
      }
    </ul>

    <div class="rise grid gap-3 sm:flex sm:flex-wrap lg:col-start-1 lg:row-start-2 lg:self-start">
      <a href={whatsappUrl(lang === 'ar' ? 'السلام عليكم، أرغب بحجز خدمة من أمان.' : "Hello, I'd like to book a service with Aman.")} rel="noopener" class="btn btn-primary min-h-14 px-8 text-base" data-hero-cta>
        <Icon name="whatsapp" class="size-6 text-gold-200" />
        {ui.bookWhatsApp[lang]}
      </a>
      <a href={href(lang, 'packages')} class="btn btn-ghost min-h-14 px-8 text-base">{ui.seePackages[lang]}</a>
    </div>

    <div class="relative mx-auto w-full max-w-[18.75rem] rise [animation-delay:150ms] sm:max-w-sm lg:col-start-2 lg:row-span-2 lg:row-start-1">
      <HeartLine class="absolute -top-6 end-0 z-10 hidden w-48 text-gold-500 sm:block" />
      <div class="parallax">
        <Visual
          lang={lang}
          photo="hero"
          alt={c.heroAlt}
          art="logo"
          tone="cream"
          eager
          widths={[300, 600, 800]}
          sizes="(min-width: 640px) 384px, 300px"
          class="shadow-card"
        />
      </div>
      <!-- This season's offer, floating -->
      <a
        href={href(lang, 'offers')}
        class="absolute -bottom-6 -start-4 w-60 rounded-3xl bg-cream-50 p-5 shadow-float ring-1 ring-gold-500/20 transition-transform duration-300 hover:-translate-y-1 active:scale-[0.98] sm:-start-8 sm:w-64"
      >
        <span class="flex items-center gap-2 text-xs font-semibold text-gold-700">
          <Icon name={featured.icon} class="size-4" />
          {featured.event[lang]}
        </span>
        <span class="mt-2 block font-semibold leading-snug text-green-800">{featured.title[lang]}</span>
        {featured.endsAt && (
          <span class="mt-2 block text-xs text-ink-500">
            <Countdown lang={lang} endsAt={featured.endsAt} />
          </span>
        )}
      </a>
    </div>
  </div>
</section>

<!-- Seasonal offers -->
<section id="offers" class="scroll-mt-28 bg-cream-200/60 py-16 md:py-24">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="reveal max-w-2xl">
        <h2 class="text-3xl text-green-800 md:text-4xl">{c.offersTitle}</h2>
        <p class="mt-3 text-ink-600">{c.offersText}</p>
      </div>
      <a href={href(lang, 'offers')} class="btn btn-ghost">
        {c.offersAll}
        <Icon name="arrow" class="size-4" flip />
      </a>
    </div>

    <!-- Live offer: a notification-style bar with every detail, about half the old card's height. -->
    <article class="reveal mt-8 grid grid-cols-[5rem_1fr] gap-x-4 gap-y-3 rounded-3xl bg-green-800 p-4 text-cream-100 shadow-card lg:grid-cols-[9rem_1fr_auto] lg:items-center lg:gap-x-6 lg:gap-y-2 lg:p-5">
      <Visual photo={`offer-${featured.id}`} alt="" icon={featured.icon} tone="green" shape="square" sizes="(min-width: 1024px) 144px, 80px" class="self-start lg:row-span-3 lg:self-center" />
      <div class="min-w-0 lg:self-end">
        <p class="flex flex-wrap items-center gap-x-2 text-xs font-semibold text-gold-300">
          <Icon name={featured.icon} class="size-4" />
          {featured.event[lang]}
          <span class="font-normal text-cream-200/80">{featured.when[lang]}</span>
        </p>
        <h3 class="mt-1 text-lg leading-snug text-cream-50 lg:text-xl">{featured.title[lang]}</h3>
      </div>
      <p class="col-span-2 line-clamp-2 text-sm text-cream-200 lg:col-span-1 lg:col-start-2">{featured.text[lang]}</p>
      <div class="col-span-2 flex flex-wrap items-center gap-2 text-xs text-cream-200 lg:col-span-1 lg:col-start-2 lg:self-start">
        <span>{c.includes}:</span>
        {liveServices(featured.services).map(({ slug: s, name }) => (
          <a href={href(lang, `services/${s}`)} class="inline-flex min-h-8 items-center rounded-full px-3 ring-1 ring-cream-50/20 hover:bg-cream-50/10 active:scale-[0.98]">
            {name[lang]}
          </a>
        ))}
        {featured.endsAt && (
          <span class="ms-auto inline-flex items-center gap-1 rounded-full bg-cream-50/10 px-3 py-1 text-cream-50 has-[[hidden]]:hidden lg:ms-2">
            <Icon name="clock" class="size-4 text-gold-300" />
            <Countdown lang={lang} endsAt={featured.endsAt} />
          </span>
        )}
      </div>
      <a href={whatsappUrl(offerMessage(featured.event[lang]))} rel="noopener" class="btn btn-light col-span-2 min-h-11 text-sm lg:col-span-1 lg:col-start-3 lg:row-span-3 lg:row-start-1">
        <Icon name="whatsapp" class="size-5" />
        {c.claim}
      </a>
    </article>

    <!-- Welcome offer: a slim bar. -->
    <article class="reveal mt-3 flex items-center gap-3 rounded-3xl bg-pink-100 p-3 md:gap-4 md:px-5 md:py-4">
      <span class="hidden size-11 shrink-0 items-center justify-center rounded-full bg-cream-50 text-gold-700 sm:flex">
        <Icon name="gift" class="size-5" />
      </span>
      <div class="min-w-0 flex-1 ps-1 sm:ps-0">
        <h3 class="text-sm text-green-800 md:text-base">{c.welcomeTitle} <span class="font-semibold text-ink-700">{welcomeOffer.name[lang]}</span></h3>
        <p class="line-clamp-1 text-xs text-ink-600 md:text-sm">{welcomeOffer.detail[lang]}</p>
      </div>
      <a href={whatsappUrl(welcomeMsg)} rel="noopener" class="btn btn-primary min-h-11 shrink-0 px-3 text-sm md:px-6" aria-label={`${ui.bookWhatsApp[lang]}: ${welcomeOffer.name[lang]}`}>
        <Icon name="whatsapp" class="size-5" />
        <span class="hidden md:inline">{ui.bookWhatsApp[lang]}</span>
      </a>
    </article>

    <!-- Coming soon: smaller bars that scroll sideways. -->
    <h3 class="mt-10 text-lg text-green-800">{ui.comingNext[lang]}</h3>
    <div
      class="-mx-4 mt-3 snap-x snap-mandatory overflow-x-auto scroll-px-4 px-4 pb-3 focus-visible:outline-offset-[-2px] md:mx-0 md:scroll-px-0 md:px-0"
      tabindex="0"
      role="region"
      aria-label={ui.comingNext[lang]}
    >
    <ul class="flex gap-3">
      {
        upcomingOffers.map((o) => (
          <li class="flex w-72 shrink-0 snap-start items-center gap-3 rounded-2xl bg-cream-50 p-2.5 shadow-soft ring-1 ring-green-700/5">
            <Visual photo={`offer-${o.id}`} alt="" icon={o.icon} shape="square" sizes="64px" class="w-16 shrink-0" />
            <div class="min-w-0">
              <p class="flex items-center gap-1.5 text-sm font-semibold text-green-800">
                <Icon name={o.icon} class="size-4 shrink-0 text-gold-600" />
                <span class="truncate">{o.event[lang]}</span>
              </p>
              <p class="text-xs text-ink-500">
                {o.when[lang]}
                {o.hijri && ` (${ui.expected[lang]})`}
              </p>
              <p class="mt-0.5 line-clamp-2 text-xs text-ink-600">{o.title[lang]}</p>
            </div>
          </li>
        ))
      }
    </ul>
    </div>
  </div>
</section>

<!-- Services -->
<section id="services" class="scroll-mt-28 py-16 md:py-24">
  <div class="container-x">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl text-green-800 md:text-4xl">{c.servicesTitle}</h2>
      <p class="mt-3 text-ink-600">{c.servicesText}</p>
    </div>
    <ul class="reveal-group mt-10 grid gap-6">
      {featuredServices.map((s) => <li><ServiceCard lang={lang} service={s} size="featured" /></li>)}
    </ul>
    <ul class="reveal-group mt-6 grid gap-6 md:grid-cols-3">
      {coreServices.map((s) => <li><ServiceCard lang={lang} service={s} /></li>)}
    </ul>
    <h3 class="mt-16 text-2xl text-green-800">{c.moreHelpTitle}</h3>
    <ul class="reveal-group mt-6 grid gap-4 lg:grid-cols-3">
      {moreServices.map((s) => <li><ServiceCard lang={lang} service={s} size="compact" headingLevel="h4" /></li>)}
      <li class="lg:col-span-3">
        <div class="flex flex-col items-start gap-4 rounded-3xl border border-dashed border-gold-500/40 p-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            <span class="flex size-12 items-center justify-center rounded-full bg-gold-50 text-gold-700">
              <Icon name="more" class="size-6" stroke={2.4} />
            </span>
            <div>
              <h4 class="text-xl text-green-800">{c.moreTitle}</h4>
              <p class="text-ink-600">{c.moreText}</p>
            </div>
          </div>
