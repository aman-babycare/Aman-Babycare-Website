---
// Home page body, shared by / and /en/. Copy is per language below.
// Order: hero → trust strip → seasonal offers → services → packages → Book Your Service → how it works →
// one visit, many jobs → trust → FAQ → closing.
// The full offer calendar is also on /offers/. The booking card is here and on /packages/.
// REVIEW-AR: Arabic copy is a first draft.
import Icon from '../Icon.astro';
import Visual from '../Visual.astro';
import HeartLine from '../HeartLine.astro';
import HeroBackdrop from '../HeroBackdrop.astro';
import Countdown from '../Countdown.astro';
import ServiceCard from '../ServiceCard.astro';
import PackageCard from '../PackageCard.astro';
import FAQ from '../FAQ.astro';
import BookingCard from '../BookingCard.astro';
import Reviews from '../Reviews.astro';
import { whatsappUrl, type Locale } from '../../config/site';
import { coreServices, featuredServices, liveServices, moreServices, serviceBySlug } from '../../data/services';
import { featuredOffer as featured, upcomingOffers } from '../../data/offers';
import { packages, welcomeOffer } from '../../data/packages';
import { href, ui } from '../../i18n/ui';
import { homeFaqShown } from '../../data/home';
import { business } from '../../data/business';
import { hasPhoto } from '../../lib/photos';
import { homeKeywordLine, moded, seo, tr } from '../../data/seo';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

