---
// Careers: open roles (src/content-data/jobs.json, edited from the admin panel's Jobs page), how hiring works,
// and the application form. Applications land on the admin panel's Applicants page. The page always exists (a
// stable URL for search engines); with no open roles it still takes general applications.
// No salary, benefits or numbers here: none are in the business data. REVIEW-AR: Arabic is a first draft.
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import ApplyForm from '../ApplyForm.astro';
import Icon from '../Icon.astro';
import logoSource from '../../assets/logo-full.png';
import type { Locale } from '../../config/site';
import { employmentLabel, employmentType, openJobs, points } from '../../data/jobs';
import { href, ui } from '../../i18n/ui';
import { breadcrumbSchema, jobPostingSchema } from '../../lib/schema';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const crumbs = [
  { name: ui.nav.home[lang], url: href(lang, '') },
  { name: ui.nav.careers[lang], url: href(lang, 'careers') },
];

const t = {
  ar: {
    title: 'وظائف رعاية الأطفال والمنازل في الرياض | أمان',
    description: 'انضمّوا إلى فريق أمان في الرياض: وظائف جليسات أطفال ورعاية مواليد وتنظيف منزلي بدوام كامل أو جزئي. قدّموا طلبكم من الموقع خلال دقيقتين.',
    h1: 'انضمّوا إلى فريق أمان',
    lead: 'نبحث عن أشخاص يحبون رعاية الأطفال والبيوت، ويعاملون كل عائلة كأنها عائلتهم. تعرّفوا على الوظائف المتاحة وقدّموا طلبكم من هنا.',
    points: ['العمل في بيوت العائلات داخل الرياض', 'وظائف بدوام كامل أو جزئي أو بمواعيد مرنة', 'نتواصل معكم عبر واتساب'],
    applyCta: 'قدّموا الآن',
    rolesTitle: 'الوظائف المتاحة',
    noRoles: 'لا توجد وظائف معلنة حالياً، ويسعدنا أن نستقبل طلبكم العام لنتواصل معكم عند توفر وظيفة مناسبة.',
    duties: 'المهام',
    requirements: 'المتطلبات',
    applyRole: 'قدّموا على هذه الوظيفة',
    stepsTitle: 'كيف يتم التوظيف',
    steps: [
      { t: 'قدّموا طلبكم', d: 'املؤوا النموذج في هذه الصفحة. يكفي دقيقتان.' },
      { t: 'نتواصل معكم', d: 'نراجع الطلبات، ونتواصل عبر واتساب مع من تناسب خبرتهم الوظيفة لترتيب مقابلة قصيرة.' },
      { t: 'التحقق والبدء', d: 'نطلب المستندات ونجري التحقق من الخلفية قبل بدء العمل مع العائلات.' },
    ],
  },
  en: {
    title: 'Caregiver & Housekeeper Jobs in Riyadh | Aman',
    description: 'Join Aman in Riyadh: babysitter, newborn care and housekeeping jobs, full-time or part-time. Apply on our website in two minutes.',
    h1: 'Join the Aman team',
    lead: 'We’re looking for people who love caring for children and homes, and who treat every family like their own. See the open roles and apply here.',
    points: ['Work in family homes across Riyadh', 'Full-time, part-time and flexible roles', 'We get back to you on WhatsApp'],
    applyCta: 'Apply now',
    rolesTitle: 'Open roles',
    noRoles: 'There are no advertised roles right now, but we’d be glad to receive a general application and contact you when a suitable role opens.',
    duties: 'Duties',
    requirements: 'Requirements',
    applyRole: 'Apply for this role',
    stepsTitle: 'How hiring works',
    steps: [
      { t: 'Apply', d: 'Fill in the form on this page. It takes two minutes.' },
      { t: 'We contact you', d: 'We read the applications and message people whose experience suits the role on WhatsApp to arrange a short interview.' },
      { t: 'Checks, then start', d: 'We ask for your documents and run a background check before you start with families.' },
    ],
  },
}[lang];

const logo = await getImage({ src: logoSource, width: 512, format: 'png' });
const pageUrl = new URL(href(lang, 'careers'), Astro.site).href;
const schema = [
  breadcrumbSchema(crumbs, Astro.site),
  ...openJobs.map((j) =>
    jobPostingSchema(lang, j, { url: `${pageUrl}#job-${j.id}`, site: Astro.site, logo: new URL(logo.src, Astro.site).href, employmentType: employmentType[j.employment] }),
  ),
];
const waMessage = lang === 'ar' ? 'السلام عليكم، أرغب بالاستفسار عن الوظائف لدى أمان.' : "Hello, I'd like to ask about jobs at Aman.";
---

<BaseLayout lang={lang} title={t.title} description={t.description} path="careers" schema={schema} waMessage={waMessage}>
  <Breadcrumbs lang={lang} items={crumbs} />
  <article class="pb-24 md:pb-32">
    <header class="container-x grid gap-8 pb-12 pt-8 lg:grid-cols-[3fr_2fr] lg:items-end">
      <div class="max-w-3xl">
        <h1 class="text-4xl text-green-800 sm:text-5xl">{t.h1}</h1>
        <p class="mt-6 text-lg text-ink-600">{t.lead}</p>
        <a href="#apply" class="btn btn-primary mt-8">{t.applyCta}</a>
      </div>
      <ul class="grid gap-3 rounded-3xl bg-cream-50 p-6 shadow-card ring-1 ring-gold-500/15">
        {
          t.points.map((p) => (
            <li class="flex items-start gap-3 text-ink-700">
              <Icon name="check" class="mt-1 size-5 shrink-0 text-gold-600" stroke={2} />
              {p}
            </li>
          ))
        }
      </ul>
    </header>

    <section class="bg-cream-200/60 py-16 md:py-20" aria-labelledby="roles">
      <div class="container-x">
        <h2 id="roles" class="text-3xl text-green-800 md:text-4xl">{t.rolesTitle}</h2>
        {
          openJobs.length === 0 ? (
            <p class="mt-6 max-w-2xl rounded-3xl bg-cream-50 p-6 text-ink-600 shadow-card">{t.noRoles}</p>
          ) : (
            <ul class="mt-8 grid gap-6 md:grid-cols-2">
              {openJobs.map((j) => (
                <li id={`job-${j.id}`} class="flex scroll-mt-40 flex-col rounded-3xl bg-cream-50 p-6 shadow-card md:p-8">
                  <span class="self-start rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-800">{employmentLabel[j.employment][lang]}</span>
                  <h3 class="mt-4 text-2xl text-green-800">{j.title[lang]}</h3>
                  <p class="mt-3 text-ink-600">{j.summary[lang]}</p>
                  <div class="mt-5 grid gap-5 border-t border-green-700/10 pt-5">
                    {[
                      [t.duties, j.duties[lang]],
                      [t.requirements, j.requirements[lang]],
                    ].filter(([, text]) => points(text).length).map(([h, text]) => (
                      <div>
                        <h4 class="text-sm font-semibold text-green-800">{h}</h4>
                        <ul class="mt-2 grid gap-2 text-sm text-ink-700">
                          {points(text).map((p) => (
                            <li class="flex items-start gap-2">
                              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold-500" aria-hidden="true" />
                              {p}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                  <div class="mt-auto pt-6">
                    <a href={`?job=${j.id}#apply`} class="btn btn-ghost" data-apply-job={j.id}>
                      {t.applyRole}
                      <Icon name="arrow" class="size-4" flip />
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <section class="py-16 md:py-20" aria-labelledby="steps">
      <div class="container-x">
        <h2 id="steps" class="text-3xl text-green-800 md:text-4xl">{t.stepsTitle}</h2>
        <ol class="mt-10 grid gap-8 md:grid-cols-3">
          {
            t.steps.map((s, i) => (
              <li class="relative">
                <span class="flex size-12 items-center justify-center rounded-full border border-gold-500 font-display text-xl text-gold-700">{i + 1}</span>
                {i < 2 && <span class="absolute start-16 top-6 hidden h-px w-[calc(100%-4rem)] bg-gold-500/30 md:block" aria-hidden="true" />}
                <h3 class="mt-5 text-xl text-green-800">{s.t}</h3>
                <p class="mt-2 text-ink-600">{s.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <div class="container-x">
      <ApplyForm lang={lang} />
    </div>
  </article>
</BaseLayout>
